<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Stormcloud Theme -->
    <SolidColorBrush x:Key="bg/widget" Color="#2E343F"/>
    <SolidColorBrush x:Key="bg/task" Color="#3B4251"/>
    <SolidColorBrush x:Key="bg/input" Color="#3B4251"/>
    <SolidColorBrush x:Key="bg/checkbox-empty" Color="#464F60"/>
    <SolidColorBrush x:Key="bg/checkbox-filled" Color="#1E89A2"/>
    <SolidColorBrush x:Key="bg/button" Color="#1E89A2"/>
    <SolidColorBrush x:Key="bg/soft" Color="#353C48"/>
    <SolidColorBrush x:Key="fg/primary" Color="#E7EBF3"/>
    <SolidColorBrush x:Key="fg/secondary" Color="#6C798E"/>
    <SolidColorBrush x:Key="fg/danger" Color="#B53336"/>
    <SolidColorBrush x:Key="border/widget" Color="#2A313C"/>
    <SolidColorBrush x:Key="HeaderIconColor" Color="#6C798E"/>
    <FontFamily x:Key="FontRegular">pack://application:,,,/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="FontSemiBold">pack://application:,,,/Fonts/#Inter SemiBold</FontFamily>

</ResourceDictionary>
