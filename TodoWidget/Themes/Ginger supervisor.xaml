<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Ginger supervisor Theme -->
    <SolidColorBrush x:Key="bg/widget" Color="#EEE6D3"/>
    <SolidColorBrush x:Key="bg/task" Color="#F5F4F3"/>
    <SolidColorBrush x:Key="fg/soft" Color="#A2A2A2"/>
    <SolidColorBrush x:Key="bg/input" Color="#F5F4F3"/>
    <SolidColorBrush x:Key="bg/checkbox-empty" Color="#E9E6E6"/>
    <SolidColorBrush x:Key="bg/checkbox-filled" Color="#D51518"/>
    <SolidColorBrush x:Key="bg/button" Color="#D51518"/>
    <SolidColorBrush x:Key="bg/soft" Color="#E9E6E6"/>
