<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Coalglow Theme -->
    <SolidColorBrush x:Key="bg/widget" Color="#1A1E24"/>
    <SolidColorBrush x:Key="bg/task" Color="#282D35"/>
    <SolidColorBrush x:Key="bg/input" Color="#282D35"/>
    <SolidColorBrush x:Key="bg/checkbox-empty" Color="#464F60"/>
    <SolidColorBrush x:Key="bg/checkbox-filled" Color="#E05858"/>
    <SolidColorBrush x:Key="bg/button" Color="#E05858"/>
    <SolidColorBrush x:Key="bg/soft" Color="#21262D"/>
    <SolidColorBrush x:Key="fg/primary" Color="#CDD4E0"/>
    <SolidColorBrush x:Key="fg/secondary" Color="#505A6C"/>
    <SolidColorBrush x:Key="fg/danger" Color="#464F60"/>
    <SolidColorBrush x:Key="border/widget" Color="#1D2229"/>
    <SolidColorBrush x:Key="HeaderIconColor" Color="#505A6C"/>
    <FontFamily x:Key="FontRegular">pack://application:,,,/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="FontSemiBold">pack://application:,,,/Fonts/#Inter SemiBold</FontFamily>

</ResourceDictionary>
