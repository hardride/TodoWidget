<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Druid Theme -->
    <SolidColorBrush x:Key="bg/widget" Color="#1A1E24"/>
    <SolidColorBrush x:Key="bg/task" Color="#252930"/>
    <SolidColorBrush x:Key="bg/input" Color="#252930"/>
    <SolidColorBrush x:Key="bg/checkbox-empty" Color="#1A1F27"/>
    <SolidColorBrush x:Key="bg/checkbox-filled" Color="#40B1A4"/>
    <SolidColorBrush x:Key="bg/button" Color="#40B1A4"/>
    <SolidColorBrush x:Key="bg/soft" Color="#1F232A"/>
    <SolidColorBrush x:Key="fg/primary" Color="#92DAD2"/>
    <SolidColorBrush x:Key="fg/secondary" Color="#4E5B6F"/>
    <SolidColorBrush x:Key="fg/danger" Color="#F03135"/>
    <SolidColorBrush x:Key="border/widget" Color="#262A30"/>
    <SolidColorBrush x:Key="HeaderIconColor" Color="#4E5B6F"/>
    <FontFamily x:Key="FontRegular">pack://application:,,,/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="FontSemiBold">pack://application:,,,/Fonts/#Inter SemiBold</FontFamily>

</ResourceDictionary>
