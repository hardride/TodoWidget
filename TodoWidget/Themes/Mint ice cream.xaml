<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Mint ice cream Theme -->
    <SolidColorBrush x:Key="bg/widget" Color="#CBD8BF"/>
    <SolidColorBrush x:Key="bg/task" Color="#EEF6E3"/>
    <SolidColorBrush x:Key="fg/soft" Color="#7A8273"/>
    <SolidColorBrush x:Key="fg/primary" Color="#0B1A03"/>
    <SolidColorBrush x:Key="fg/secondary" Color="#91978D"/>
    <SolidColorBrush x:Key="bg/checkbox-filled" Color="#1D3A2E"/>
    <SolidColorBrush x:Key="bg/button" Color="#1D3A2E"/>
    <SolidColorBrush x:Key="fg/danger" Color="#CE1418"/>
    <SolidColorBrush x:Key="bg/checkbox-empty" Color="#CAD5BF"/>
    <SolidColorBrush x:Key="bg/soft" Color="#CAD5BF"/>
    <SolidColorBrush x:Key="bg/input" Color="#EEF6E3"/>
    <SolidColorBrush x:Key="border/widget" Color="#BBCDAB"/>
    <SolidColorBrush x:Key="HeaderIconColor" Color="#91978D"/>
    <FontFamily x:Key="FontRegular">pack://application:,,,/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="FontSemiBold">pack://application:,,,/Fonts/#Inter SemiBold</FontFamily>

</ResourceDictionary>
