<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Terminal Theme -->
    <SolidColorBrush x:Key="bg/widget" Color="#141729"/>
    <SolidColorBrush x:Key="bg/task" Color="#1A1D2F"/>
    <SolidColorBrush x:Key="bg/input" Color="#1A1D2F"/>
    <SolidColorBrush x:Key="bg/checkbox-empty" Color="#282C43"/>
    <SolidColorBrush x:Key="bg/checkbox-filled" Color="#21B568"/>
    <SolidColorBrush x:Key="bg/button" Color="#21B568"/>
    <SolidColorBrush x:Key="bg/soft" Color="#171A2C"/>
    <SolidColorBrush x:Key="fg/primary" Color="#21B568"/>
    <SolidColorBrush x:Key="fg/secondary" Color="#85899D"/>
    <SolidColorBrush x:Key="fg/danger" Color="#CF20CB"/>
    <SolidColorBrush x:Key="border/widget" Color="#35384C"/>
    <SolidColorBrush x:Key="HeaderIconColor" Color="#85899D"/>
    <FontFamily x:Key="FontRegular">pack://application:,,,/Fonts/#Source Code Pro</FontFamily>
    <FontFamily x:Key="FontSemiBold">pack://application:,,,/Fonts/#Source Code Pro SemiBold</FontFamily>

</ResourceDictionary>