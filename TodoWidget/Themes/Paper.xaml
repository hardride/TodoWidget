<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paper Theme -->
    <SolidColorBrush x:Key="bg/widget" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="bg/task" Color="#EAEAEB"/>
    <SolidColorBrush x:Key="fg/soft" Color="#A2A2A2"/>
    <SolidColorBrush x:Key="fg/primary" Color="#383840"/>
    <SolidColorBrush x:Key="fg/secondary" Color="#5D5D69"/>
    <SolidColorBrush x:Key="bg/checkbox-filled" Color="#5D5D69"/>
    <SolidColorBrush x:Key="bg/button" Color="#5D5D69"/>
    <SolidColorBrush x:Key="fg/danger" Color="#F2161B"/>
    <SolidColorBrush x:Key="bg/checkbox-empty" Color="#E3E3E3"/>
    <SolidColorBrush x:Key="bg/soft" Color="#E3E3E3"/>
    <SolidColorBrush x:Key="bg/input" Color="#EAEAEB"/>
    <SolidColorBrush x:Key="border/widget" Color="#C9CFE2"/>
    <SolidColorBrush x:Key="HeaderIconColor" Color="#5D5D69"/>
    <FontFamily x:Key="FontRegular">pack://application:,,,/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="FontSemiBold">pack://application:,,,/Fonts/#Inter SemiBold</FontFamily>

</ResourceDictionary>
