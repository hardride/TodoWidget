<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Hoarfrost Theme -->
    <SolidColorBrush x:Key="bg/widget" Color="#C8D2EE"/>
    <SolidColorBrush x:Key="bg/task" Color="#E4E8F5"/>
    <SolidColorBrush x:Key="fg/soft" Color="#8690AE"/>
    <SolidColorBrush x:Key="bg/input" Color="#E4E8F5"/>
    <SolidColorBrush x:Key="bg/checkbox-empty" Color="#CDD4E5"/>
    <SolidColorBrush x:Key="bg/checkbox-filled" Color="#2B3656"/>
    <SolidColorBrush x:Key="bg/button" Color="#2B3656"/>
    <SolidColorBrush x:Key="bg/soft" Color="#D3D9EC"/>
    <SolidColorBrush x:Key="fg/primary" Color="#1C3163"/>
    <SolidColorBrush x:Key="fg/secondary" Color="#636B84"/>
    <SolidColorBrush x:Key="fg/danger" Color="#CE1418"/>
    <SolidColorBrush x:Key="border/widget" Color="#C9CFE2"/>
    <SolidColorBrush x:Key="HeaderIconColor" Color="#636B84"/>
    <FontFamily x:Key="FontRegular">pack://application:,,,/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="FontSemiBold">pack://application:,,,/Fonts/#Inter SemiBold</FontFamily>

</ResourceDictionary>
