<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Pixel-76 Theme -->
    <SolidColorBrush x:Key="bg/widget" Color="#1B1B36"/>
    <SolidColorBrush x:Key="bg/task" Color="#2C2C4B"/>
    <SolidColorBrush x:Key="bg/input" Color="#2C2C4B"/>
    <SolidColorBrush x:Key="bg/checkbox-empty" Color="#464B65"/>
    <SolidColorBrush x:Key="bg/checkbox-filled" Color="#FE8949"/>
    <SolidColorBrush x:Key="bg/button" Color="#FE8949"/>
    <SolidColorBrush x:Key="bg/soft" Color="#232342"/>
    <SolidColorBrush x:Key="fg/primary" Color="#E2E2E2"/>
    <SolidColorBrush x:Key="fg/secondary" Color="#797E82"/>
    <SolidColorBrush x:Key="fg/danger" Color="#BC1717"/>
    <SolidColorBrush x:Key="border/widget" Color="#607386"/>
    <SolidColorBrush x:Key="HeaderIconColor" Color="#607386"/>
    <FontFamily x:Key="FontRegular">pack://application:,,,/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="FontSemiBold">pack://application:,,,/Fonts/#Inter SemiBold</FontFamily>
    <BitmapImage x:Key="WidgetBackgroundImage" UriSource="pack://application:,,,/Images/bg_aerop.png"/>

</ResourceDictionary>
