<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Nocturnal K Theme -->
    <SolidColorBrush x:Key="bg/widget" Color="#092B73"/>
    <SolidColorBrush x:Key="bg/task" Color="#1B408E"/>
    <SolidColorBrush x:Key="bg/input" Color="#1B408E"/>
    <SolidColorBrush x:Key="bg/checkbox-empty" Color="#14357C"/>
    <SolidColorBrush x:Key="bg/checkbox-filled" Color="#851912"/>
    <SolidColorBrush x:Key="bg/button" Color="#851912"/>
    <SolidColorBrush x:Key="bg/soft" Color="#14357C"/>
    <SolidColorBrush x:Key="fg/primary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="fg/secondary" Color="#4D74C5"/>
    <SolidColorBrush x:Key="fg/danger" Color="#EB4025"/>
    <SolidColorBrush x:Key="border/widget" Color="#0C307A"/>
    <SolidColorBrush x:Key="HeaderIconColor" Color="#4D74C5"/>
    <FontFamily x:Key="FontRegular">pack://application:,,,/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="FontSemiBold">pack://application:,,,/Fonts/#Inter SemiBold</FontFamily>
    <BitmapImage x:Key="WidgetBackgroundImage" UriSource="pack://application:,,,/Images/bg_best.png"/>

</ResourceDictionary>
