<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme -->
    <SolidColorBrush x:Key="bg/widget" Color="#12151B"/>
    <SolidColorBrush x:Key="bg/task" Color="#20232B"/>
    <SolidColorBrush x:Key="bg/input" Color="#20232B"/>
    <SolidColorBrush x:Key="bg/checkbox-empty" Color="#343843"/>
    <SolidColorBrush x:Key="bg/checkbox-filled" Color="#1F64A9"/>
    <SolidColorBrush x:Key="bg/button" Color="#1F64A9"/>
    <SolidColorBrush x:Key="bg/soft" Color="#1A1D24"/>
    <SolidColorBrush x:Key="fg/primary" Color="#E9EAEA"/>
    <SolidColorBrush x:Key="fg/secondary" Color="#515861"/>
    <SolidColorBrush x:Key="fg/danger" Color="#C34043"/>
    <SolidColorBrush x:Key="border/widget" Color="#272626"/>
    <SolidColorBrush x:Key="HeaderIconColor" Color="#404245"/>
    <FontFamily x:Key="FontRegular">pack://application:,,,/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="FontSemiBold">pack://application:,,,/Fonts/#Inter SemiBold</FontFamily>
    <x:Null x:Key="TextGlowEffect"/>

</ResourceDictionary>