                    <!-- Nocturnal K theme -->
                    <Border x:Name="NocturnalKThemeItem" Background="{DynamicResource bg/task}" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="NocturnalKTheme_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Nocturnal K" Foreground="{DynamicResource fg/primary}" FontFamily="{DynamicResource FontRegular}" FontSize="14" VerticalAlignment="Center"/>
                            <Path x:Name="NocturnalKCheck" Grid.Column="1" Data="{StaticResource CheckIcon}" Stroke="{DynamicResource bg/checkbox-filled}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Opacity="0"/>
                        </Grid>
                    </Border>

                    <!-- Engraving K theme -->
                    <Border x:Name="EngravingKThemeItem" Background="{DynamicResource bg/task}" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="EngravingKTheme_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Engraving K" Foreground="{DynamicResource fg/primary}" FontFamily="{DynamicResource FontRegular}" FontSize="14" VerticalAlignment="Center"/>
                            <Path x:Name="EngravingKCheck" Grid.Column="1" Data="{StaticResource CheckIcon}" Stroke="{DynamicResource bg/checkbox-filled}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Opacity="0"/>
                        </Grid>
                    </Border>

                    <!-- Graffity theme -->
                    <Border x:Name="GraffityThemeItem" Background="{DynamicResource bg/task}" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="GraffityTheme_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Graffity" Foreground="{DynamicResource fg/primary}" FontFamily="{DynamicResource FontRegular}" FontSize="14" VerticalAlignment="Center"/>
                            <Path x:Name="GraffityCheck" Grid.Column="1" Data="{StaticResource CheckIcon}" Stroke="{DynamicResource bg/checkbox-filled}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Opacity="0"/>
                        </Grid>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>

    <!-- Window outline border -->
    <Border x:Name="OutlineBorder" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource border/widget}" IsHitTestVisible="False"/>

    <!-- Height HUD Indicator (floating badge above bottom edge) -->
    <Border x:Name="HeightHud" VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Margin="0,0,0,26" CornerRadius="10" Background="{DynamicResource bg/soft}"
            BorderBrush="{DynamicResource border/widget}" BorderThickness="1"
            Padding="10,5" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5, 0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="HeightHudTranslate" Y="4"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <TextBlock x:Name="HeightHudText" Text="480 px" FontFamily="{DynamicResource FontRegular}"
                   FontSize="12" Foreground="{DynamicResource fg/primary}" FontWeight="SemiBold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>

    <!-- Group Task Thread Dragging Overlay -->
    <Canvas x:Name="LinkDragCanvas" IsHitTestVisible="False" Visibility="Collapsed">
        <Path x:Name="LinkThreadPath" Stroke="{DynamicResource fg/accent}" StrokeThickness="2"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        <Ellipse x:Name="LinkOriginDot" Width="6" Height="6" Fill="{DynamicResource fg/accent}"/>
        <Ellipse x:Name="LinkCursorDot" Width="8" Height="8" Fill="{DynamicResource fg/accent}"/>
    </Canvas>

    <!-- Resize Edge (Option 3: Ghost Glow Bar) -->
    <Grid x:Name="ResizeGripArea" VerticalAlignment="Bottom" Height="14" Cursor="SizeNS"
          Background="Transparent"
          MouseEnter="ResizeGrip_MouseEnter"
          MouseLeave="ResizeGrip_MouseLeave"
          PreviewMouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
          PreviewMouseMove="ResizeGrip_MouseMove"
          PreviewMouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"
          LostMouseCapture="ResizeGrip_LostMouseCapture">
        <!-- Glow highlight bar (shows on hover/drag) -->
        <Border x:Name="ResizeGlowBar" Height="2.5" Width="72" CornerRadius="1.25"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"
                Background="{DynamicResource fg/primary}" Opacity="0" IsHitTestVisible="False"/>
    </Grid>
</Grid>
</Window>
