                    <Border x:Name="HoarfrostThemeItem" Background="{DynamicResource bg/task}" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="HoarfrostTheme_Click">
