                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Druid" Foreground="{DynamicResource fg/primary}" FontFamily="{DynamicResource FontRegular}" FontSize="14" VerticalAlignment="Center"/>
                            <Path x:Name="DruidCheck" Grid.Column="1" Data="{StaticResource CheckIcon}" Stroke="{DynamicResource bg/checkbox-filled}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Opacity="0"/>
