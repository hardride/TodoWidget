                <Border.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Effect" Value="{DynamicResource TextGlowEffect}"/>
                    </Style>
                </Border.Resources>
                <ScrollViewer x:Name="ThemesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewerStyle}">
                    <StackPanel>
                    <!-- Dark theme -->
                    <Border x:Name="DarkThemeItem" Background="{DynamicResource bg/task}" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="DarkTheme_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
