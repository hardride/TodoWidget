<Window x:Class="TodoWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Todo Widget"
        Width="340" Height="480"
        MinWidth="340" MaxWidth="340"
        WindowStartupLocation="Manual"
        Left="100" Top="100"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <!-- Fonts -->
        <FontFamily x:Key="InterRegular">pack://application:,,,/Fonts/#Inter</FontFamily>
        <FontFamily x:Key="InterSemiBold">pack://application:,,,/Fonts/#Inter SemiBold</FontFamily>

        <!-- Lucide Icon Paths -->
        <StreamGeometry x:Key="CheckIcon">M20 6 9 17l-5-5</StreamGeometry>
        <StreamGeometry x:Key="BlendIcon">M15 9a7 7 0 1 1-1.37-4.26 M9 15a7 7 0 1 1 1.37 4.26</StreamGeometry>
        <StreamGeometry x:Key="ArrowDownToLineIcon">M12 17V3 m6 8-6 6-6-6 M19 21H5</StreamGeometry>
        <StreamGeometry x:Key="PaintbrushIcon">m14.622 17.897-10.68-2.913 M18.376 2.622a1 1 0 1 1 3.002 3.002L17.36 9.643a.5.5 0 0 0 0 .707l.944.944a2.41 2.41 0 0 1 0 3.408l-.944.944a.5.5 0 0 1-.707 0L8.354 7.348a.5.5 0 0 1 0-.707l.944-.944a2.41 2.41 0 0 1 3.408 0l.944.944a.5.5 0 0 0 .707 0z M9 8c-1.804 2.71-3.97 3.46-6.583 3.948a.507.507 0 0 0-.302.819l7.32 8.883a1 1 0 0 0 1.185.204C12.735 20.405 16 16.792 16 15</StreamGeometry>
        <StreamGeometry x:Key="PinIcon">M12 17v5 M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z</StreamGeometry>
        <StreamGeometry x:Key="PinOffIcon">M12 17v5 M15 9.34V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H7.89 M2 2 20 20 M9 9v1.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h11</StreamGeometry>

        <!-- Icon button style -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource IconHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox without focus border -->
        <Style x:Key="FlatTextBox" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0,8,0" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim ScrollBar overlay style -->
        <Style x:Key="SlimScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       HorizontalAlignment="Right"
                                       Width="4"
                                       Margin="0,0,1,0"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Background="Transparent"
                                       Opacity="0.4"
                                       Cursor="Hand">
                                <ScrollBar.Template>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Border CornerRadius="2" Background="Transparent">
                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                <Track.Thumb>
                                                    <Thumb x:Name="SlimThumb" Width="4" MinWidth="4" MaxWidth="4" Background="#66FFFFFF" Cursor="Hand">
                                                        <Thumb.Style>
                                                            <Style TargetType="Thumb">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Thumb">
                                                                            <Border CornerRadius="2" Width="4" Background="{TemplateBinding Background}"/>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#AAFFFFFF"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsDragging" Value="True">
                                                                        <Setter Property="Background" Value="#CCFFFFFF"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Thumb.Style>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Border>
                                    </ControlTemplate>
                                </ScrollBar.Template>
                            </ScrollBar>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder" CornerRadius="12" Background="{DynamicResource WidgetBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="8" ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Background image (only visible in Argentina theme) -->
            <Border x:Name="ImageClipBorder" Grid.Row="2" Grid.RowSpan="2" IsHitTestVisible="False" VerticalAlignment="Bottom" Background="Transparent">
                <Border.Clip>
                    <RectangleGeometry RadiusX="12" RadiusY="12" Rect="0,0,340,117"/>
                </Border.Clip>
                <Image x:Name="ThemeBackgroundImage" Stretch="None" HorizontalAlignment="Center" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource WidgetBg}" CornerRadius="11,11,0,0" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Name="HeaderTitle" Text="ADHD to-do" Foreground="{DynamicResource TextPrimary}" FontFamily="{DynamicResource FontRegular}" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Name="TaskCounter" Text="0/0" Foreground="{DynamicResource TextSecondary}" FontFamily="{DynamicResource FontRegular}" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Theme (paintbrush) -->
                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="ThemeButton_Click">
                        <Path Name="ThemeIconPath" Data="{StaticResource PaintbrushIcon}" Stroke="#404245" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>

                    <!-- Opacity (blend) -->
                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="OpacityButton_Click">
                        <Path Data="{StaticResource BlendIcon}" Stroke="{DynamicResource HeaderIconColor}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>

                    <!-- Pin -->
                    <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Click="PinButton_Click">
                        <Path Name="PinIconPath" Data="{StaticResource PinIcon}" Stroke="#1F64A9" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>

                    <!-- Minimize to tray -->
                    <Button Grid.Column="4" Style="{StaticResource IconButtonStyle}" Click="CloseButton_Click">
                        <Path Data="{StaticResource ArrowDownToLineIcon}" Stroke="{DynamicResource HeaderIconColor}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Opacity Slider (hidden) -->
            <Border x:Name="OpacitySliderBorder" Grid.Row="1" Background="{DynamicResource IconHoverBg}" Padding="16,8" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Opacity" Foreground="{DynamicResource TextSecondary}" FontFamily="{DynamicResource FontRegular}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Slider Name="OpacitySlider" Width="160" Minimum="0.2" Maximum="1.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OpacitySlider_Changed"/>
                    <TextBlock Name="OpacityValueText" Text="100%" Foreground="{DynamicResource TextSecondary}" FontFamily="{DynamicResource FontRegular}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" Width="36"/>
                </StackPanel>
            </Border>

            <!-- === Tasks View === -->
            <Border x:Name="TasksView" Grid.Row="2" Grid.RowSpan="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Todo List -->
                    <Border Grid.Row="0" Padding="8,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewerStyle}">
                            <ItemsControl Name="TodoList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource TaskBg}" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}" Click="TodoCheckbox_Click" Tag="{Binding Id}" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <CheckBox.Template>
                                                        <ControlTemplate TargetType="CheckBox">
                                                            <Grid Width="22" Height="22" Cursor="Hand">
                                                                <Border x:Name="CBBorder" Width="22" Height="22" CornerRadius="6" Background="{DynamicResource CheckboxBg}"/>
                                                                <Path x:Name="CBCheck" Data="{StaticResource CheckIcon}" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" Margin="0,0,0,2" Width="14" Height="14" Stretch="Uniform"/>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="CBBorder" Property="Background" Value="{DynamicResource Accent}"/>
                                                                    <Setter TargetName="CBCheck" Property="Visibility" Value="Visible"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="CBBorder" Property="Background" Value="{DynamicResource CheckboxHoverBg}"/>
                                                                </Trigger>
                                                                <MultiTrigger>
                                                                    <MultiTrigger.Conditions>
                                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                                        <Condition Property="IsChecked" Value="True"/>
                                                                    </MultiTrigger.Conditions>
                                                                    <Setter TargetName="CBBorder" Property="Background" Value="{DynamicResource AccentHover}"/>
                                                                </MultiTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </CheckBox.Template>
                                                </CheckBox>

                                                <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" FontFamily="{DynamicResource FontRegular}" FontSize="14" Foreground="{DynamicResource TextPrimary}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Grid.Column="2" Text="&#x2715;" Tag="{Binding Id}" MouseLeftButtonDown="DeleteText_Click" Foreground="{DynamicResource DeleteFg}" FontFamily="{DynamicResource FontRegular}" FontSize="14" Cursor="Hand" VerticalAlignment="Center" Padding="8,2" Opacity="0.7">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Add Task Input -->
                    <Border Grid.Row="1" Padding="8,6,8,10">
                        <Grid Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="{DynamicResource InputBg}" CornerRadius="6">
                                <TextBox Name="NewTaskInput"
                                         Style="{StaticResource FlatTextBox}"
                                         BorderThickness="0"
                                         FontFamily="{DynamicResource FontRegular}" FontSize="14"
                                         Foreground="{DynamicResource TextPrimary}"
                                         VerticalContentAlignment="Center"
                                         Background="Transparent"
                                         CaretBrush="#1F64A9"
                                         KeyDown="NewTaskInput_KeyDown"
                                         TextChanged="NewTaskInput_TextChanged"
                                         GotFocus="NewTaskInput_GotFocus"
                                         LostFocus="NewTaskInput_LostFocus"/>
                            </Border>
                            <TextBlock Name="WatermarkText" Text="Add a task..." Margin="8,0,0,0" FontFamily="{DynamicResource FontRegular}" FontSize="14" Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False" VerticalAlignment="Center"/>

                            <Button Grid.Column="1" Name="AddButton" Width="32" Height="32" Margin="6,0,0,0" Background="{DynamicResource Accent}" BorderThickness="0" Cursor="Hand" Click="AddButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <Path Data="M5 12h14 M12 5v14" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentHover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- === Themes View (hidden) === -->
            <Border x:Name="ThemesView" Grid.Row="2" Grid.RowSpan="2" Visibility="Collapsed" Padding="12,12">
                <StackPanel>
                    <!-- Dark theme -->
                    <Border x:Name="DarkThemeItem" Background="{DynamicResource TaskBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="DarkTheme_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dark" Foreground="{DynamicResource TextPrimary}" FontFamily="{DynamicResource FontRegular}" FontSize="14" VerticalAlignment="Center"/>
                            <Path x:Name="DarkCheck" Grid.Column="1" Data="{StaticResource CheckIcon}" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Light theme -->
                    <Border x:Name="LightThemeItem" Background="{DynamicResource TaskBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="LightTheme_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Light" Foreground="{DynamicResource TextPrimary}" FontFamily="{DynamicResource FontRegular}" FontSize="14" VerticalAlignment="Center"/>
                            <Path x:Name="LightCheck" Grid.Column="1" Data="{StaticResource CheckIcon}" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Opacity="0"/>
                        </Grid>
                    </Border>

                    <!-- Kanagawa theme -->
                    <Border x:Name="KanagawaThemeItem" Background="{DynamicResource TaskBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="KanagawaTheme_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Kanagawa" Foreground="{DynamicResource TextPrimary}" FontFamily="{DynamicResource FontRegular}" FontSize="14" VerticalAlignment="Center"/>
                            <Path x:Name="KanagawaCheck" Grid.Column="1" Data="{StaticResource CheckIcon}" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Opacity="0"/>
                        </Grid>
                    </Border>

                    <!-- Owl theme -->
                    <Border x:Name="ArgentinaThemeItem" Background="{DynamicResource TaskBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="ArgentinaTheme_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Argentina for Plemyannic" Foreground="{DynamicResource TextPrimary}" FontFamily="{DynamicResource FontRegular}" FontSize="14" VerticalAlignment="Center"/>
                            <Path x:Name="ArgentinaCheck" Grid.Column="1" Data="{StaticResource CheckIcon}" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Opacity="0"/>
                        </Grid>
                    </Border>

                    <!-- Scarlet theme -->
                    <Border x:Name="TerminalThemeItem" Background="{DynamicResource TaskBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="TerminalTheme_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Terminal" Foreground="{DynamicResource TextPrimary}" FontFamily="{DynamicResource FontRegular}" FontSize="14" VerticalAlignment="Center"/>
                            <Path x:Name="TerminalCheck" Grid.Column="1" Data="{StaticResource CheckIcon}" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Opacity="0"/>
                        </Grid>
                    </Border>

                    <!-- Reilly theme -->
                    <Border x:Name="ReillyThemeItem" Background="{DynamicResource TaskBg}" CornerRadius="6" Padding="12,10" Cursor="Hand" MouseLeftButtonDown="ReillyTheme_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Reilly" Foreground="{DynamicResource TextPrimary}" FontFamily="{DynamicResource FontRegular}" FontSize="14" VerticalAlignment="Center"/>
                            <Path x:Name="ReillyCheck" Grid.Column="1" Data="{StaticResource CheckIcon}" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Opacity="0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
