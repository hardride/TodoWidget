<Border x:Name="MainBorder" Width="320" HorizontalAlignment="Left" CornerRadius="12" Background="{DynamicResource bg/widget}" ClipToBounds="True" SizeChanged="MainBorder_SizeChanged" Panel.ZIndex="10">
            <Border.Clip>
                <RectangleGeometry x:Name="MainClip" RadiusX="12" RadiusY="12" Rect="0,0,1,1"/>
            </Border.Clip>

            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Background image (only visible in themes with images) -->
            <Image x:Name="ThemeBackgroundImage" Grid.Row="0" Grid.RowSpan="2" Stretch="None" VerticalAlignment="Bottom" HorizontalAlignment="Center" Opacity="0" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Header -->
            <Border Grid.Row="0" Background="Transparent" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Name="HeaderTitle" Text="ADHD to-do" Effect="{DynamicResource TextGlowEffect}" Foreground="{DynamicResource fg/primary}" FontFamily="{DynamicResource FontRegular}" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Name="TimerText" Text="00:00:00" Effect="{DynamicResource TextGlowEffect}" Foreground="{DynamicResource fg/primary}" FontFamily="{DynamicResource FontRegular}" FontSize="16" VerticalAlignment="Center" Visibility="Collapsed" Typography.NumeralAlignment="Tabular"/>
                        <TextBlock Name="TaskCounter" Text="0/0" Foreground="{DynamicResource fg/secondary}" FontFamily="{DynamicResource FontRegular}" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Audio Player (audio-waveform) -->
                    <Button x:Name="AudioButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="AudioButton_Click" ToolTip="Музыка для концентрации">
                        <Path x:Name="AudioIconPath" Data="{StaticResource AudioWaveformIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>

                    <!-- Settings (settings-2) -->
                    <Button x:Name="SettingsButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="SettingsButton_Click">
                        <Path x:Name="SettingsIconPath" Data="{StaticResource WrenchIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>

                    <!-- Pin -->
                    <Button x:Name="PinButton" Grid.Column="3" Style="{StaticResource IconButtonStyle}" Click="PinButton_Click">
                        <Path x:Name="PinIconPath" Data="{StaticResource PinIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>

                    <!-- Minimize to tray -->
                    <Button x:Name="CloseButton" Grid.Column="4" Style="{StaticResource IconButtonStyle}" Click="CloseButton_Click">
                        <Path x:Name="CloseIconPath" Data="{StaticResource Minimize2Icon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <!-- === Tasks View === -->
            <Border x:Name="TasksView" Grid.Row="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Scrollable area: active tasks + completed tasks -->
                    <Border Grid.Row="0" Padding="8,8,0,0">
                        <Grid Name="TodoListGrid">
                            <ScrollViewer x:Name="TasksScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewerStyle}" Padding="0,0,8,0">
                            <StackPanel>
                                <!-- Active Todo List -->
                                <ItemsControl Name="TodoList">
                                    <ItemsControl.Resources>
                                        <DataTemplate DataType="{x:Type models:TodoItem}">
                                            <Border x:Name="TaskCard" Background="{DynamicResource bg/task}"
                                                    CornerRadius="{Binding CardCornerRadius}" Padding="8" Margin="{Binding CardMargin}"
                                                    RenderTransformOrigin="0.5, 0.5"
                                                    ClipToBounds="True"
                                                    MouseEnter="TaskBorder_MouseEnter" MouseLeave="TaskBorder_MouseLeave"
                                                    PreviewMouseLeftButtonDown="TaskBorder_MouseLeftButtonDown"
                                                    PreviewMouseMove="TaskBorder_MouseMove"
                                                    PreviewMouseLeftButtonUp="TaskBorder_MouseLeftButtonUp">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Opacity" Value="0.5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}" Click="TodoCheckbox_Click" Tag="{Binding Id}" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <CheckBox.Template>
                                                            <ControlTemplate TargetType="CheckBox">
                                                                <Grid Width="22" Height="22" Cursor="Hand">
                                                                    <Border x:Name="CBBorder" Width="22" Height="22" CornerRadius="4" Background="{DynamicResource bg/checkbox-empty}"/>
                                                                    <Path x:Name="CBCheck" Data="{StaticResource CheckIcon}" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" Margin="0,0,0,2" Width="14" Height="14" Stretch="Uniform"/>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="CBBorder" Property="Background" Value="{DynamicResource bg/checkbox-filled}"/>
                                                                        <Setter TargetName="CBCheck" Property="Visibility" Value="Visible"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="CBBorder" Property="Background" Value="{DynamicResource bg/checkbox-empty/hover}"/>
                                                                    </Trigger>
                                                                    <MultiTrigger>
                                                                        <MultiTrigger.Conditions>
                                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                                            <Condition Property="IsChecked" Value="True"/>
                                                                        </MultiTrigger.Conditions>
                                                                        <Setter TargetName="CBBorder" Property="Background" Value="{DynamicResource bg/checkbox-filled/hover}"/>
                                                                    </MultiTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </CheckBox.Template>
                                                    </CheckBox>

                                                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock x:Name="TaskTitleText" Text="{Binding Title}" TextWrapping="Wrap" TextTrimming="None"
                                                                   VerticalAlignment="Center" FontFamily="{DynamicResource FontRegular}" FontSize="14" Foreground="{DynamicResource fg/primary}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Effect" Value="{DynamicResource TextGlowEffect}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource fg/soft}"/>
                                                                            <Setter Property="Effect" Value="{x:Null}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBox x:Name="TaskEditBox" Text="{Binding Title, Mode=OneWay}" Visibility="Collapsed"
                                                                 Style="{StaticResource InlineEditTextBox}" FontFamily="{DynamicResource FontRegular}"
                                                                 FontSize="14" Foreground="{DynamicResource fg/primary}"
                                                                 CaretBrush="{DynamicResource fg/primary}"
                                                                 VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                                 KeyDown="TaskEditBox_KeyDown" LostFocus="TaskEditBox_LostFocus"/>
                                                        <Border x:Name="StrikeLine" Height="1.5" Background="{DynamicResource fg/soft}"
                                                                VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                                RenderTransformOrigin="0, 0.5" IsHitTestVisible="False" CornerRadius="0.75" Opacity="0.85">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <ScaleTransform ScaleX="0" ScaleY="1"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="RenderTransform">
                                                                                <Setter.Value>
                                                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </Grid>

                                                    <StackPanel x:Name="IconsPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Flame icon (urgent) - visible on hover or when urgent -->
                                                        <Border x:Name="FireBorder" Visibility="Collapsed" Cursor="Hand" Padding="4,2" Margin="0,0,4,0"
                                                                Tag="{Binding Id}" MouseLeftButtonDown="UrgentText_Click">
                                                            <Border.ToolTip>
                                                                <ToolTip Background="{DynamicResource bg/task}" BorderBrush="{DynamicResource border/widget}" BorderThickness="1">
                                                                    <TextBlock Text="Пометить как срочное" Foreground="{DynamicResource fg/primary}" FontFamily="{DynamicResource FontRegular}" FontSize="12"/>
                                                                </ToolTip>
                                                            </Border.ToolTip>
                                                            <Border Width="18" Height="18" VerticalAlignment="Center" ClipToBounds="True">
                                                                <Viewbox Stretch="Uniform">
                                                                    <lottie:LottieAnimationView x:Name="FireIcon"
                                                                          AutoPlay="True" RepeatCount="-1"
                                                                          Width="18" Height="18"
                                                                          MinWidth="0" MinHeight="0"
                                                                          ResourcePath="pack://application:,,,/Animations/flame.json"/>
                                                                </Viewbox>
                                                            </Border>
                                                        </Border>

                                                        <!-- Delete button -->
                                                        <TextBlock Text="&#x2715;" Tag="{Binding Id}" MouseLeftButtonDown="DeleteText_Click"
                                                                   Foreground="{DynamicResource fg/danger}" FontFamily="{DynamicResource FontRegular}" FontSize="14"
                                                                   Cursor="Hand" VerticalAlignment="Center" Padding="8,2" Opacity="0.7">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Opacity" Value="1"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>

                                        <!-- Draggable Deadline Line -->
                                        <DataTemplate DataType="{x:Type models:DeadlineItem}">
                                            <Border x:Name="DeadlineContainer" Margin="{Binding ContainerMargin}" Cursor="SizeNS"
                                                    Background="Transparent"
                                                    PreviewMouseLeftButtonDown="Deadline_MouseLeftButtonDown"
                                                    PreviewMouseMove="Deadline_MouseMove"
                                                    PreviewMouseLeftButtonUp="Deadline_MouseLeftButtonUp">
                                                <Grid Height="20" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left: Add line button (+) - starts at width 0 (hidden), expands on hover -->
                                                    <Border x:Name="AddLineBtn" Grid.Column="0" Width="0" Height="20" Cursor="Hand" Background="Transparent"
                                                            VerticalAlignment="Center" HorizontalAlignment="Left" ClipToBounds="True" Opacity="0" Tag="{Binding Id}"
                                                            TextElement.Foreground="{DynamicResource fg/soft}"
                                                            PreviewMouseLeftButtonDown="AddDeadlineLine_Click">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Opacity" Value="0.8"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Opacity" Value="1.0"/>
                                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource fg/primary}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid Width="20" Height="20">
                                                            <Path Data="M8 3v10 M3 8h10" Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                                                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Left line (fg/soft, 1px, goes to edge when not hovered) -->
                                                    <Border Grid.Column="1" Height="1" Background="{DynamicResource fg/soft}" VerticalAlignment="Center"/>

                                                    <!-- Center text: deadline (pure text without container, fg/soft) -->
                                                    <!-- Center: Title and Inline Edit -->
                                                    <Grid Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Cursor="SizeNS">
                                                        <!-- Center display panel -->
                                                        <DockPanel x:Name="DeadlineDisplayPanel" MaxWidth="210" LastChildFill="True"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                   Margin="8,0">
                                                            <!-- Target / Bullseye icon on the left of label -->
                                                            <Border x:Name="DeadlineTargetBtn" DockPanel.Dock="Left" Width="12" Height="12"
                                                                    Margin="0,0,4,0" VerticalAlignment="Center" Cursor="Arrow"
                                                                    Background="Transparent"
                                                                    PreviewMouseLeftButtonDown="DeadlineTarget_MouseLeftButtonDown"
                                                                    PreviewMouseMove="DeadlineTarget_MouseMove"
                                                                    PreviewMouseLeftButtonUp="DeadlineTarget_MouseLeftButtonUp">
                                                                <Path Data="{StaticResource TargetIcon}"
                                                                      Stroke="{DynamicResource fg/soft}" StrokeThickness="1.2"
                                                                      Width="8" Height="8" Stretch="Uniform"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                                                                                    <Setter Property="Stroke" Value="{DynamicResource fg/primary}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                            </Border>

                                                            <!-- Timer on the right (always fully visible) -->
                                                            <TextBlock x:Name="DeadlineTimerText" DockPanel.Dock="Right"
                                                                       Text="{Binding TimerText}" Visibility="{Binding TimerVisibility}"
                                                                       FontFamily="{DynamicResource FontRegular}" FontSize="11"
                                                                       Typography.NumeralAlignment="Tabular"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource fg/soft}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource fg/primary}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource fg/danger}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <!-- Dot separator directly before timer -->
                                                            <TextBlock x:Name="DeadlineSepText" DockPanel.Dock="Right"
                                                                       Text=" · " Visibility="{Binding SeparatorVisibility}"
                                                                       FontFamily="{DynamicResource FontRegular}" FontSize="11"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource fg/soft}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource fg/primary}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <!-- Label text on the left (trims with ellipsis if long) -->
                                                            <TextBlock x:Name="DeadlineLabelText"
                                                                       Text="{Binding LabelText}" Visibility="{Binding LabelVisibility}"
                                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                                       FontFamily="{DynamicResource FontRegular}" FontSize="11"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource fg/soft}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource fg/primary}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DockPanel>

                                                        <!-- Inline Edit Box -->
                                                        <TextBox x:Name="DeadlineEditBox" Text="{Binding FullDisplayText, Mode=OneWay}" Visibility="Collapsed"
                                                                 Style="{StaticResource InlineEditTextBox}" FontFamily="{DynamicResource FontRegular}"
                                                                 FontSize="11" Foreground="{DynamicResource fg/soft}"
                                                                 CaretBrush="{DynamicResource fg/soft}"
                                                                 Typography.NumeralAlignment="Tabular"
                                                                 VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                                                                 MinWidth="60" MaxWidth="210" Padding="4,0"
                                                                 KeyDown="DeadlineEditBox_KeyDown" LostFocus="DeadlineEditBox_LostFocus"/>
                                                    </Grid>

                                                    <!-- Right line (fg/soft, 1px, goes to edge when not hovered) -->
                                                    <Border Grid.Column="3" Height="1" Background="{DynamicResource fg/soft}" VerticalAlignment="Center"/>

                                                    <!-- Right: Delete line button (✕) - matching task delete cross -->
                                                    <Border x:Name="DeleteLineBtn" Grid.Column="4" Width="0" Height="20" Cursor="Hand" Background="Transparent"
                                                            VerticalAlignment="Center" HorizontalAlignment="Right" ClipToBounds="True" Opacity="0" Tag="{Binding Id}"
                                                            PreviewMouseLeftButtonDown="DeleteDeadlineLine_Click">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Opacity" Value="0.7"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Opacity" Value="1.0"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid Width="20" Height="20">
                                                            <!-- Delete cross (shown when deadline has NO grouped tasks) -->
                                                            <TextBlock x:Name="DeleteCrossText" Text="&#x2715;" Foreground="{DynamicResource fg/danger}"
                                                                       FontFamily="{DynamicResource FontRegular}" FontSize="14"
                                                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,2,0"/>
                                                            <!-- Trending up-down icon (shown when deadline HAS grouped tasks, for ungrouping) -->
                                                            <Path x:Name="TrendingUpDownIcon" Data="{StaticResource TrendingUpDownIcon}"
                                                                  Stroke="{DynamicResource fg/danger}" StrokeThickness="1.5"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                                  Width="12" Height="12" Stretch="Uniform"
                                                                  VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,2,0"
                                                                  Visibility="Collapsed"/>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasGroupedTasks}" Value="True">
                                                    <Setter TargetName="DeleteCrossText" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="TrendingUpDownIcon" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsScrollBarVisible, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ThicknessAnimation Storyboard.TargetName="DeleteLineBtn" Storyboard.TargetProperty="Margin"
                                                                                    To="0,0,8,0" Duration="0:0:0.25">
                                                                    <ThicknessAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </ThicknessAnimation.EasingFunction>
                                                                </ThicknessAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ThicknessAnimation Storyboard.TargetName="DeleteLineBtn" Storyboard.TargetProperty="Margin"
                                                                                    To="0,0,0,0" Duration="0:0:0.35">
                                                                    <ThicknessAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </ThicknessAnimation.EasingFunction>
                                                                </ThicknessAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                                <Trigger SourceName="DeadlineContainer" Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="AddLineBtn" Storyboard.TargetProperty="Width" To="20" Duration="0:0:0.18">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="AddLineBtn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetName="DeleteLineBtn" Storyboard.TargetProperty="Width" To="20" Duration="0:0:0.18">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="DeleteLineBtn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="AddLineBtn" Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseIn"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="AddLineBtn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                                                <DoubleAnimation Storyboard.TargetName="DeleteLineBtn" Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseIn"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="DeleteLineBtn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.Resources>
                                </ItemsControl>

                                <!-- Fallback Add Deadline Line (visible only when 0 deadline lines exist) -->
                                <Border x:Name="AddDeadlineFallback" Visibility="Collapsed" Padding="4,4,4,4" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" Cursor="Hand" MouseLeftButtonDown="AddFallbackDeadline_Click" HorizontalAlignment="Center" Opacity="0.6">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="1.0"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Path Data="M8 3v10 M3 8h10" Stroke="{DynamicResource fg/soft}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="title" Foreground="{DynamicResource fg/soft}" FontFamily="{DynamicResource FontRegular}" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Completed tasks section -->
                                <Border x:Name="CompletedSection" Visibility="Collapsed" Padding="4,6,4,2" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Cursor="Hand" MouseLeftButtonDown="CompletedSection_Click" Background="Transparent">
                                            <Path x:Name="CompletedArrow" Data="M9 18l6-6-6-6" Stroke="{DynamicResource fg/soft}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" RenderTransformOrigin="0.5, 0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0"/>
                                                </Path.RenderTransform>
                                            </Path>
                                            <TextBlock Name="CompletedText" Text="Завершенные (0)" Foreground="{DynamicResource fg/soft}" FontFamily="{DynamicResource FontRegular}" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ClearCompletedButton" Grid.Column="1" Text="Очистить всё"
                                                   Foreground="{DynamicResource fg/soft}" FontFamily="{DynamicResource FontRegular}" FontSize="11"
                                                   Cursor="Hand" VerticalAlignment="Center" Padding="4,0" Opacity="0.7"
                                                   Visibility="Collapsed" MouseLeftButtonDown="ClearCompletedButton_Click">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource fg/danger}"/>
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Completed tasks list -->
                                <ItemsControl Name="CompletedList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="CompletedCard" Background="{DynamicResource bg/task}" CornerRadius="8" Padding="8" Margin="0,0,0,6" Opacity="0.5"
                                                    ClipToBounds="True"
                                                    MouseEnter="TaskBorder_MouseEnter" MouseLeave="TaskBorder_MouseLeave">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}" Click="TodoCheckbox_Click" Tag="{Binding Id}" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <CheckBox.Template>
                                                            <ControlTemplate TargetType="CheckBox">
                                                                <Grid Width="22" Height="22" Cursor="Hand">
                                                                    <Border x:Name="CBBorder" Width="22" Height="22" CornerRadius="4" Background="{DynamicResource bg/checkbox-filled}"/>
                                                                    <Path x:Name="CBCheck" Data="{StaticResource CheckIcon}" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,0,2" Width="14" Height="14" Stretch="Uniform"/>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="CBBorder" Property="Background" Value="{DynamicResource bg/checkbox-filled/hover}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </CheckBox.Template>
                                                    </CheckBox>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextDecorations="Strikethrough" Foreground="{DynamicResource fg/soft}" FontFamily="{DynamicResource FontRegular}" FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="&#x2715;" Tag="{Binding Id}" MouseLeftButtonDown="DeleteText_Click"
                                                               Foreground="{DynamicResource fg/danger}" FontFamily="{DynamicResource FontRegular}" FontSize="14"
                                                               Cursor="Hand" VerticalAlignment="Center" Padding="8,2" Opacity="0.7"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <Border x:Name="DropIndicator" Height="1" Background="{DynamicResource fg/primary}"
                                CornerRadius="0.5" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                Margin="2,0,10,0" IsHitTestVisible="False" Visibility="Collapsed">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="DropIndicatorTransform" Y="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </Border>

                    <!-- Add Task Input -->
                    <Border Grid.Row="1" Padding="8,6,8,10">
                        <Grid Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="{DynamicResource bg/input}" CornerRadius="8">
                                <TextBox Name="NewTaskInput"
                                         Style="{StaticResource FlatTextBox}"
                                         BorderThickness="0"
                                         FontFamily="{DynamicResource FontRegular}" FontSize="14"
                                         Foreground="{DynamicResource fg/primary}"
                                         Effect="{DynamicResource TextGlowEffect}"
                                         VerticalContentAlignment="Center"
                                         Background="Transparent"
                                         CaretBrush="{DynamicResource bg/checkbox-filled}"
                                         KeyDown="NewTaskInput_KeyDown"
                                         TextChanged="NewTaskInput_TextChanged"
                                         GotFocus="NewTaskInput_GotFocus"
                                         LostFocus="NewTaskInput_LostFocus"/>
                            </Border>
                            <TextBlock Name="WatermarkText" Text="Add a task..." Margin="8,0,0,0" FontFamily="{DynamicResource FontRegular}" FontSize="14" Foreground="{DynamicResource fg/secondary}" IsHitTestVisible="False" VerticalAlignment="Center"/>

                            <Button Grid.Column="1" Name="AddButton" Width="32" Height="32" Margin="6,0,0,0" Background="{DynamicResource bg/button}" BorderThickness="0" Cursor="Hand" Click="AddButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                                                        <Path Data="M5 12h14 M12 5v14" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource bg/button/hover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- === Audio Player View (hidden) === -->
            <Border x:Name="AudioView" Grid.Row="1" Visibility="Collapsed" Padding="12,10,4,12">
                <Border.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Effect" Value="{DynamicResource TextGlowEffect}"/>
                    </Style>
                </Border.Resources>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Player Card -->
                    <Border Grid.Row="0" Background="{DynamicResource bg/task}" CornerRadius="10" Padding="12,10" Margin="0,0,8,8">
                        <StackPanel>
                            <!-- Track Info Header -->
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock x:Name="AudioTrackTitleText" Text="Звуки природы" Foreground="{DynamicResource fg/primary}" FontFamily="{DynamicResource FontSemiBold}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Hidden Timeline Slider & Time Labels (ambient background sounds loop continuously without seeking) -->
                            <Slider x:Name="AudioTimelineSlider" Visibility="Collapsed" Style="{StaticResource ModernAudioSliderStyle}"/>
                            <TextBlock x:Name="AudioCurrentTimeText" Visibility="Collapsed"/>
                            <TextBlock x:Name="AudioTotalTimeText" Visibility="Collapsed"/>

                            <!-- Player Controls -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Volume mute button + Volume slider + Volume percentage -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="AudioMuteButton" Style="{StaticResource IconButtonStyle}" Click="AudioMuteButton_Click" ToolTip="Звук вкл/выкл" Margin="0,0,2,0" Padding="3">
                                        <Path x:Name="AudioVolumeIconPath" Data="{StaticResource Volume2Icon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
                                    </Button>
                                    <Slider x:Name="AudioVolumeSlider" Width="42" Minimum="0" Maximum="1" Value="0.7"
                                            ValueChanged="AudioVolumeSlider_ValueChanged"
                                            PreviewMouseDown="AudioVolumeSlider_PreviewMouseDown"
                                            PreviewMouseMove="AudioVolumeSlider_PreviewMouseMove"
                                            PreviewMouseUp="AudioVolumeSlider_PreviewMouseUp"
                                            VerticalAlignment="Center" Cursor="Hand"
                                            Style="{StaticResource ModernAudioSliderStyle}"/>
                                    <TextBlock x:Name="AudioVolumePercentText" Text="70%" Foreground="{DynamicResource fg/soft}" FontFamily="{DynamicResource FontRegular}" FontSize="10" Margin="3,0,0,0" VerticalAlignment="Center" Width="24" Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>

                                <!-- Center Controls: Prev, Play/Pause, Next -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button x:Name="AudioPrevButton" Style="{StaticResource IconButtonStyle}" Click="AudioPrevButton_Click" ToolTip="Предыдущий" Padding="4" Margin="0,0,2,0">
                                        <Path Data="{StaticResource SkipBackIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
                                    </Button>

                                    <!-- Big Play/Pause Button -->
                                    <Border x:Name="AudioPlayPauseBorder" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource bg/button}" Cursor="Hand" MouseLeftButtonDown="AudioPlayPause_Click" ToolTip="Play / Pause">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Path x:Name="AudioPlayPauseIcon" Data="{StaticResource PlayIcon}" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" Width="14" Height="14" Stretch="Uniform"/>
                                    </Border>

                                    <Button x:Name="AudioNextButton" Style="{StaticResource IconButtonStyle}" Click="AudioNextButton_Click" ToolTip="Следующий" Padding="4" Margin="2,0,0,0">
                                        <Path Data="{StaticResource SkipForwardIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>

                                <!-- Right: Spacer / Equalizer badge -->
                                <Border Grid.Column="2" Width="90" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Track List / Playlist -->
                    <Border Grid.Row="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Медитация и фокус" Foreground="{DynamicResource fg/secondary}" FontFamily="{DynamicResource FontSemiBold}" FontSize="12" Margin="4,2,0,6"/>

                            <ScrollViewer Grid.Row="1" x:Name="AudioScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewerStyle}" Padding="0,0,8,0">
                                <StackPanel x:Name="AudioTracksStackPanel">
                                    <!-- Populated in code-behind -->
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>

    <!-- Window outline border -->
    <Border x:Name="OutlineBorder" Width="320" HorizontalAlignment="Left" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource border/widget}" IsHitTestVisible="False" Panel.ZIndex="11"/>

    <!-- Height HUD Indicator (floating badge above bottom edge) -->
    <Border x:Name="HeightHud" Width="90" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="115,0,0,26" Panel.ZIndex="12" CornerRadius="10" Background="{DynamicResource bg/soft}"
            BorderBrush="{DynamicResource border/widget}" BorderThickness="1"
            Padding="10,5" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5, 0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="HeightHudTranslate" Y="4"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <TextBlock x:Name="HeightHudText" Text="480 px" FontFamily="{DynamicResource FontRegular}"
                   FontSize="12" Foreground="{DynamicResource fg/primary}" FontWeight="SemiBold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>

    <!-- Group Task Thread Dragging Overlay -->
    <Canvas x:Name="LinkDragCanvas" IsHitTestVisible="False" Visibility="Collapsed" Panel.ZIndex="13">
        <Path x:Name="LinkThreadPath" Stroke="{DynamicResource fg/accent}" StrokeThickness="2"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        <Ellipse x:Name="LinkOriginDot" Width="6" Height="6" Fill="{DynamicResource fg/accent}"/>
        <Ellipse x:Name="LinkCursorDot" Width="8" Height="8" Fill="{DynamicResource fg/accent}"/>
    </Canvas>

    <!-- Resize Edge (Option 3: Ghost Glow Bar) -->
    <Grid x:Name="ResizeGripArea" Width="320" HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="14" Cursor="SizeNS" Panel.ZIndex="14"
          Background="Transparent"
          MouseEnter="ResizeGrip_MouseEnter"
          MouseLeave="ResizeGrip_MouseLeave"
          PreviewMouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
          PreviewMouseMove="ResizeGrip_MouseMove"
          PreviewMouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"
          LostMouseCapture="ResizeGrip_LostMouseCapture">
        <!-- Glow highlight bar (shows on hover/drag) -->
        <Border x:Name="ResizeGlowBar" Height="2.5" Width="72" CornerRadius="1.25"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"
                Background="{DynamicResource fg/primary}" Opacity="0" IsHitTestVisible="False"/>
    </Grid>
</Grid>
</Window>
