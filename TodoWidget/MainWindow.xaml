<Window x:Class="TodoWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
        xmlns:models="clr-namespace:TodoWidget.Models"
        xmlns:local="clr-namespace:TodoWidget"
        Title="Todo Widget"
        Width="320" Height="480"
        MinWidth="320" MaxWidth="600"
        MinHeight="260" MaxHeight="1400"
        WindowStartupLocation="Manual"
        Left="100" Top="100"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <!-- Fallback Theme Brush -->
        <SolidColorBrush x:Key="fg/soft" Color="#515861"/>
        <SolidColorBrush x:Key="fg/accent" Color="#1F64A9"/>

        <!-- Fonts -->
        <FontFamily x:Key="InterRegular">pack://application:,,,/Fonts/#Inter</FontFamily>
        <FontFamily x:Key="InterSemiBold">pack://application:,,,/Fonts/#Inter SemiBold</FontFamily>

        <!-- Lucide Icon Paths -->
        <StreamGeometry x:Key="CheckIcon">M20 6 9 17l-5-5</StreamGeometry>
        <StreamGeometry x:Key="Minimize2Icon">M14,10 L21,3 M20,10 L14,10 L14,4 M3,21 L10,14 M4,14 L10,14 L10,20</StreamGeometry>
        <StreamGeometry x:Key="PinIcon">M12 17v5 M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z</StreamGeometry>
        <StreamGeometry x:Key="PinOffIcon">M12 17v5 M15 9.34V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H7.89 M2 2 20 20 M9 9v1.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h11</StreamGeometry>
        <StreamGeometry x:Key="TargetIcon">M 12,3.5 A 8.5,8.5 0 1 0 12,20.5 A 8.5,8.5 0 1 0 12,3.5 M 12,11 A 1,1 0 1 0 12,13 A 1,1 0 1 0 12,11</StreamGeometry>
        <StreamGeometry x:Key="TrendingUpDownIcon">M 14.828,14.828 L 21,21 M 21,16 v 5 h -5 M 21,3 l -9,9 -4,-4 -6,6 M 21,8 V 3 h -5</StreamGeometry>
        <StreamGeometry x:Key="AudioWaveformIcon">M2 13a2 2 0 0 0 2-2V7a2 2 0 0 1 4 0v13a2 2 0 0 0 4 0V4a2 2 0 0 1 4 0v13a2 2 0 0 0 4 0v-4a2 2 0 0 1 2-2</StreamGeometry>
        <StreamGeometry x:Key="PlayIcon">M 5,5 A 2,2 0 0 1 8.008,3.272 L 20.005,10.27 A 2,2 0 0 1 20.008,13.728 L 8.008,20.728 A 2,2 0 0 1 5,19 Z</StreamGeometry>
        <StreamGeometry x:Key="PauseIcon">M 5,4 A 1,1 0 0 1 6,3 H 9 A 1,1 0 0 1 10,4 V 20 A 1,1 0 0 1 9,21 H 6 A 1,1 0 0 1 5,20 Z M 14,4 A 1,1 0 0 1 15,3 H 18 A 1,1 0 0 1 19,4 V 20 A 1,1 0 0 1 18,21 H 15 A 1,1 0 0 1 14,20 Z</StreamGeometry>
        <StreamGeometry x:Key="SkipBackIcon">M 3,4 V 20 M 17.971,4.285 A 2,2 0 0 1 21,6 V 18 A 2,2 0 0 1 17.971,19.715 L 7.974,13.717 A 2,2 0 0 1 7.971,10.285 Z</StreamGeometry>
        <StreamGeometry x:Key="SkipForwardIcon">M 21,4 V 20 M 6.029,4.285 A 2,2 0 0 0 3,6 V 18 A 2,2 0 0 0 6.029,19.715 L 16.026,13.717 A 2,2 0 0 0 16.029,10.285 Z</StreamGeometry>
        <StreamGeometry x:Key="Volume2Icon">M 11,4.702 A 0.705,0.705 0 0 0 9.797,4.204 L 6.413,7.587 A 1.4,1.4 0 0 1 5.416,8 H 3 A 1,1 0 0 0 2,9 V 15 A 1,1 0 0 0 3,16 H 5.416 A 1.4,1.4 0 0 1 6.413,16.413 L 9.796,19.797 A 0.705,0.705 0 0 0 11,19.298 Z M 16,9 A 5,5 0 0 1 16,15 M 19.364,18.364 A 9,9 0 0 0 19.364,5.636</StreamGeometry>
        <StreamGeometry x:Key="VolumeXIcon">M 11,4.702 A 0.705,0.705 0 0 0 9.797,4.204 L 6.413,7.587 A 1.4,1.4 0 0 1 5.416,8 H 3 A 1,1 0 0 0 2,9 V 15 A 1,1 0 0 0 3,16 H 5.416 A 1.4,1.4 0 0 1 6.413,16.413 L 9.796,19.797 A 0.705,0.705 0 0 0 11,19.298 Z M 16.5,14.5 L 21.5,9.5 M 16.5,9.5 L 21.5,14.5</StreamGeometry>
        <StreamGeometry x:Key="WrenchIcon">M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z</StreamGeometry>
        <StreamGeometry x:Key="CloseXIcon">M 18 6 L 6 18 M 6 6 L 18 18</StreamGeometry>

        <!-- Icon button style -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource HeaderIconColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource bg/soft}"/>
                    <Setter Property="Foreground" Value="{DynamicResource fg/primary}"/>
                </Trigger>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="{DynamicResource bg/task}"/>
                    <Setter Property="Foreground" Value="{DynamicResource fg/primary}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="Tag" Value="Active"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource bg/task}"/>
                    <Setter Property="Opacity" Value="0.85"/>
                    <Setter Property="Foreground" Value="{DynamicResource fg/primary}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

                <!-- Settings Theme Card Style (compact transparent items) -->
        <Style x:Key="SettingsThemeItemStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource bg/soft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox without focus border -->
        <Style x:Key="FlatTextBox" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0,8,0" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inline Task Edit TextBox style -->
        <Style x:Key="InlineEditTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim ScrollBar overlay style -->
        <Style x:Key="SlimScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter Margin="{TemplateBinding Padding}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       HorizontalAlignment="Right"
                                       Width="2"
                                       Margin="0,0,2,0"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Background="Transparent"
                                       Opacity="0"
                                       Cursor="Hand">
                                <ScrollBar.Template>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Border CornerRadius="1" Background="Transparent">
                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                <Track.Thumb>
                                                    <Thumb x:Name="SlimThumb" Width="2" MinWidth="2" MaxWidth="2" Background="#66FFFFFF" Cursor="Hand">
                                                        <Thumb.Style>
                                                            <Style TargetType="Thumb">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Thumb">
                                                                            <Border CornerRadius="1" Width="2" Background="{TemplateBinding Background}"/>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#AAFFFFFF"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsDragging" Value="True">
                                                                        <Setter Property="Background" Value="#CCFFFFFF"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Thumb.Style>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Border>
                                    </ControlTemplate>
                                </ScrollBar.Template>
                            </ScrollBar>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Audio Slider Style -->
        <Style x:Key="AudioSliderThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumbBorder" Width="10" Height="10" CornerRadius="5" Background="{DynamicResource fg/primary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBorder" Property="Width" Value="12"/>
                                <Setter TargetName="thumbBorder" Property="Height" Value="12"/>
                                <Setter TargetName="thumbBorder" Property="CornerRadius" Value="6"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource bg/checkbox-filled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernAudioSliderStyle" TargetType="Slider">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="16" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource bg/checkbox-empty}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource bg/checkbox-filled}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="16"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource AudioSliderThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Settings CheckBox Style -->
        <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="20" Height="20" Cursor="Hand" Background="Transparent">
                            <Border x:Name="CBBorder" Width="20" Height="20" CornerRadius="4" Background="{DynamicResource bg/checkbox-empty}"/>
                            <Path x:Name="CBCheck" Data="{StaticResource CheckIcon}" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" Margin="0,0,0,1" Width="12" Height="12" Stretch="Uniform"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CBBorder" Property="Background" Value="{DynamicResource bg/checkbox-filled}"/>
                                <Setter TargetName="CBCheck" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CBBorder" Property="Background" Value="{DynamicResource bg/checkbox-empty/hover}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CBBorder" Property="Background" Value="{DynamicResource bg/checkbox-filled/hover}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
            <!-- 240px Settings Panel inside Clipping Container -->
    <Grid x:Name="SettingsClipContainer"
          Width="240" HorizontalAlignment="Left"
          Margin="320,16,0,16"
          ClipToBounds="True"
          Visibility="Collapsed"
          Panel.ZIndex="6">
        <Border x:Name="SettingsPanel"
                Width="240" HorizontalAlignment="Left"
                Background="{DynamicResource bg/widget}"
                BorderBrush="{DynamicResource border/widget}"
                BorderThickness="0,1,1,1"
                CornerRadius="0,12,12,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SettingsPanelTranslate" X="-240"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Settings Header -->
                <Border Grid.Row="0" Background="Transparent" Padding="14,12,12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource border/widget}" MouseLeftButtonDown="SettingsHeader_MouseLeftButtonDown">
                    <Grid>
                        <TextBlock x:Name="SettingsTitleText" Text="Settings" Foreground="{DynamicResource fg/primary}" FontFamily="{DynamicResource FontSemiBold}" FontSize="13" VerticalAlignment="Center"/>
                        <Button x:Name="SettingsCloseButton" HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Click="SettingsCloseButton_Click" Width="24" Height="24" ToolTip="Close">
                            <Path Data="{StaticResource CloseXIcon}" Stroke="{DynamicResource fg/secondary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Settings Tabs Bar (Scrollable Single Row, Underlined) -->
                <Border Grid.Row="1" Background="Transparent" BorderBrush="{DynamicResource border/widget}" BorderThickness="0,0,0,1" Margin="12,4,12,6" Padding="0">
                    <ScrollViewer x:Name="TabsScrollViewer"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  PanningMode="HorizontalOnly"
                                  Focusable="False"
                                  PreviewMouseWheel="TabsScrollViewer_PreviewMouseWheel">
                        <StackPanel Orientation="Horizontal">
                            <!-- General Tab -->
                            <Border x:Name="TabBtnGeneral" Cursor="Hand" Padding="8,4,8,6" Margin="0,0,8,0" Background="Transparent" BorderBrush="{DynamicResource fg/primary}" BorderThickness="0,0,0,2" MouseLeftButtonDown="TabBtnGeneral_Click">
                                <TextBlock x:Name="TabTxtGeneral" Text="General" Foreground="{DynamicResource fg/primary}" FontFamily="{DynamicResource FontSemiBold}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Themes Tab -->
                            <Border x:Name="TabBtnThemes" Cursor="Hand" Padding="8,4,8,6" Margin="0,0,8,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" MouseLeftButtonDown="TabBtnThemes_Click">
                                <TextBlock x:Name="TabTxtThemes" Text="Themes" Foreground="{DynamicResource fg/secondary}" FontFamily="{DynamicResource FontRegular}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Opacity Tab -->
                            <Border x:Name="TabBtnOpacity" Cursor="Hand" Padding="8,4,8,6" Margin="0,0,8,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" MouseLeftButtonDown="TabBtnOpacity_Click">
                                <TextBlock x:Name="TabTxtOpacity" Text="Opacity" Foreground="{DynamicResource fg/secondary}" FontFamily="{DynamicResource FontRegular}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- About Tab -->
                            <Border x:Name="TabBtnAbout" Cursor="Hand" Padding="8,4,8,6" Margin="0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" MouseLeftButtonDown="TabBtnAbout_Click">
                                <TextBlock x:Name="TabTxtAbout" Text="About" Foreground="{DynamicResource fg/secondary}" FontFamily="{DynamicResource FontRegular}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Settings Content (Scrollable) -->
                <ScrollViewer Grid.Row="2" x:Name="SettingsScrollViewer" Style="{StaticResource SlimScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,8">
                    <Grid>
                        <!-- TAB 1: General (Основные) -->
                        <StackPanel x:Name="TabContentGeneral" Visibility="Visible">
                            <TextBlock x:Name="LblGeneralTasks" Text="Tasks" Foreground="{DynamicResource fg/secondary}" FontFamily="{DynamicResource FontSemiBold}" FontSize="11" Margin="2,4,0,6"/>
                            <Border Background="Transparent" Padding="4,4" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock x:Name="LblCompletedTasksTitle" Text="Completed tasks" Foreground="{DynamicResource fg/primary}" FontFamily="{DynamicResource FontRegular}" FontSize="12"/>
                                        <TextBlock x:Name="LblCompletedTasksDesc" Text="Keep in place when unchecked" Foreground="{DynamicResource fg/secondary}" FontFamily="{DynamicResource FontRegular}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="CompletedTasksCheckbox" IsChecked="True" VerticalAlignment="Center" Click="CompletedTasksCheckbox_Click" Style="{StaticResource SettingsCheckBoxStyle}"/>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="LblGeneralLanguage" Text="Language" Foreground="{DynamicResource fg/secondary}" FontFamily="{DynamicResource FontSemiBold}" FontSize="11" Margin="2,0,0,6"/>
                            <Border Background="{DynamicResource bg/task}" CornerRadius="8" Margin="0,0,0,8" Padding="2">
                                <UniformGrid Columns="3" Rows="1">
                                    <!-- English -->
                                    <Border x:Name="LangBtnEn" CornerRadius="6" Cursor="Hand" Padding="0,6" Background="{DynamicResource bg/widget}" BorderBrush="{DynamicResource border/widget}" BorderThickness="1" MouseLeftButtonDown="LangBtnEn_Click">
                                        <TextBlock x:Name="LangTxtEn" Text="English" Foreground="{DynamicResource fg/primary}" FontFamily="{DynamicResource FontSemiBold}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Russian -->
                                    <Border x:Name="LangBtnRu" CornerRadius="6" Cursor="Hand" Padding="0,6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" MouseLeftButtonDown="LangBtnRu_Click">
                                        <TextBlock x:Name="LangTxtRu" Text="Русский" Foreground="{DynamicResource fg/secondary}" FontFamily="{DynamicResource FontRegular}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Spanish -->
                                    <Border x:Name="LangBtnEs" CornerRadius="6" Cursor="Hand" Padding="0,6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" MouseLeftButtonDown="LangBtnEs_Click">
                                        <TextBlock x:Name="LangTxtEs" Text="Español" Foreground="{DynamicResource fg/secondary}" FontFamily="{DynamicResource FontRegular}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </UniformGrid>
                            </Border>
                        </StackPanel>

                        <!-- TAB 2: Themes -->
                        <StackPanel x:Name="TabContentThemes" Visibility="Collapsed">
                            <TextBlock x:Name="LblThemesHeader" Text="Themes" Foreground="{DynamicResource fg/secondary}" FontFamily="{DynamicResource FontSemiBold}" FontSize="11" Margin="2,4,0,6"/>
                            <StackPanel Margin="0,0,0,10">
<!-- Dark theme -->
                            <Border x:Name="DarkThemeItem" Style="{StaticResource SettingsThemeItemStyle}" MouseLeftButtonDown="DarkTheme_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Dark" Foreground="{DynamicResource fg/primary}" FontFamily="{DynamicResource FontRegular}" FontSize="13" VerticalAlignment="Center" Effect="{DynamicResource TextGlowEffect}"/>
                                    <Path x:Name="DarkCheck" Grid.Column="1" Data="{StaticResource CheckIcon}" Stroke="{DynamicResource bg/checkbox-filled}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Light theme -->
                            <Border x:Name="LightThemeItem" Style="{StaticResource SettingsThemeItemStyle}" MouseLeftButtonDown="LightTheme_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Light" Foreground="{DynamicResource fg/primary}" FontFamily="{DynamicResource FontRegular}" FontSize="13" VerticalAlignment="Center" Effect="{DynamicResource TextGlowEffect}"/>
                                    <Path x:Name="LightCheck" Grid.Column="1" Data="{StaticResource CheckIcon}" Stroke="{DynamicResource bg/checkbox-filled}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Opacity="0"/>
                                </Grid>
                            </Border>

                            <!-- Kanagawa theme -->
                            <Border x:Name="KanagawaThemeItem" Style="{StaticResource SettingsThemeItemStyle}" MouseLeftButtonDown="KanagawaTheme_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Kanagawa" Foreground="{DynamicResource fg/primary}" FontFamily="{DynamicResource FontRegular}" FontSize="13" VerticalAlignment="Center" Effect="{DynamicResource TextGlowEffect}"/>
                                    <Path x:Name="KanagawaCheck" Grid.Column="1" Data="{StaticResource CheckIcon}" Stroke="{DynamicResource bg/checkbox-filled}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Opacity="0"/>
                                </Grid>
                            </Border>

                            <!-- Argentina theme -->
                            <Border x:Name="ArgentinaThemeItem" Style="{StaticResource SettingsThemeItemStyle}" MouseLeftButtonDown="ArgentinaTheme_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Argentina for Plemyannic" Foreground="{DynamicResource fg/primary}" FontFamily="{DynamicResource FontRegular}" FontSize="13" VerticalAlignment="Center" Effect="{DynamicResource TextGlowEffect}"/>
                                    <Path x:Name="ArgentinaCheck" Grid.Column="1" Data="{StaticResource CheckIcon}" Stroke="{DynamicResource bg/checkbox-filled}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Opacity="0"/>
                                </Grid>
                            </Border>

                            <!-- Terminal theme -->
