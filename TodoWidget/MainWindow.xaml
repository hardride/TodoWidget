<Window x:Class="TodoWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
        Title="Todo Widget"
        Width="320" Height="480"
        MinWidth="320" MaxWidth="320"
        WindowStartupLocation="Manual"
        Left="100" Top="100"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <!-- Fonts -->
        <FontFamily x:Key="InterRegular">pack://application:,,,/Fonts/#Inter</FontFamily>
        <FontFamily x:Key="InterSemiBold">pack://application:,,,/Fonts/#Inter SemiBold</FontFamily>

        <!-- Lucide Icon Paths -->
        <StreamGeometry x:Key="CheckIcon">M20 6 9 17l-5-5</StreamGeometry>
        <StreamGeometry x:Key="BlendIcon">M15 9a7 7 0 1 1-1.37-4.26 M9 15a7 7 0 1 1 1.37 4.26</StreamGeometry>
        <StreamGeometry x:Key="Minimize2Icon">M14,10 L21,3 M20,10 L14,10 L14,4 M3,21 L10,14 M4,14 L10,14 L10,20</StreamGeometry>
        <StreamGeometry x:Key="PaintbrushIcon">m14.622 17.897-10.68-2.913 M18.376 2.622a1 1 0 1 1 3.002 3.002L17.36 9.643a.5.5 0 0 0 0 .707l.944.944a2.41 2.41 0 0 1 0 3.408l-.944.944a.5.5 0 0 1-.707 0L8.354 7.348a.5.5 0 0 1 0-.707l.944-.944a2.41 2.41 0 0 1 3.408 0l.944.944a.5.5 0 0 0 .707 0z M9 8c-1.804 2.71-3.97 3.46-6.583 3.948a.507.507 0 0 0-.302.819l7.32 8.883a1 1 0 0 0 1.185.204C12.735 20.405 16 16.792 16 15</StreamGeometry>
        <StreamGeometry x:Key="PinIcon">M12 17v5 M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z</StreamGeometry>
        <StreamGeometry x:Key="PinOffIcon">M12 17v5 M15 9.34V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H7.89 M2 2 20 20 M9 9v1.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h11</StreamGeometry>

        <!-- Icon button style -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource HeaderIconColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource bg/soft}"/>
                    <Setter Property="Foreground" Value="{DynamicResource fg/primary}"/>
                </Trigger>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="{DynamicResource bg/task}"/>
                    <Setter Property="Foreground" Value="{DynamicResource fg/primary}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="Tag" Value="Active"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource bg/task}"/>
                    <Setter Property="Opacity" Value="0.85"/>
                    <Setter Property="Foreground" Value="{DynamicResource fg/primary}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox without focus border -->
        <Style x:Key="FlatTextBox" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0,8,0" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim ScrollBar overlay style -->
        <Style x:Key="SlimScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       HorizontalAlignment="Right"
                                       Width="4"
                                       Margin="0"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Background="Transparent"
                                       Opacity="0.4"
                                       Cursor="Hand">
                                <ScrollBar.Template>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Border CornerRadius="2" Background="Transparent">
                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                <Track.Thumb>
                                                    <Thumb x:Name="SlimThumb" Width="4" MinWidth="4" MaxWidth="4" Background="#66FFFFFF" Cursor="Hand">
                                                        <Thumb.Style>
                                                            <Style TargetType="Thumb">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Thumb">
                                                                            <Border CornerRadius="2" Width="4" Background="{TemplateBinding Background}"/>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#AAFFFFFF"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsDragging" Value="True">
                                                                        <Setter Property="Background" Value="#CCFFFFFF"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Thumb.Style>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Border>
                                    </ControlTemplate>
                                </ScrollBar.Template>
                            </ScrollBar>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="MainBorder" CornerRadius="12" Background="{DynamicResource bg/widget}" ClipToBounds="True" SizeChanged="MainBorder_SizeChanged">
            <Border.Clip>
                <RectangleGeometry x:Name="MainClip" RadiusX="12" RadiusY="12" Rect="0,0,1,1"/>
            </Border.Clip>

            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Background image (only visible in themes with images) -->
            <Image x:Name="ThemeBackgroundImage" Grid.Row="0" Grid.RowSpan="4" Stretch="None" VerticalAlignment="Bottom" HorizontalAlignment="Center" Opacity="0" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Header -->
            <Border Grid.Row="0" Background="Transparent" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Name="HeaderTitle" Text="ADHD to-do" Effect="{DynamicResource TextGlowEffect}" Foreground="{DynamicResource fg/primary}" FontFamily="{DynamicResource FontRegular}" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Name="TimerText" Text="00:00:00" Effect="{DynamicResource TextGlowEffect}" Foreground="{DynamicResource fg/primary}" FontFamily="{DynamicResource FontRegular}" FontSize="16" VerticalAlignment="Center" Visibility="Collapsed" Typography.NumeralAlignment="Tabular"/>
                        <TextBlock Name="TaskCounter" Text="0/0" Foreground="{DynamicResource fg/secondary}" FontFamily="{DynamicResource FontRegular}" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Theme (paintbrush) -->
                    <Button x:Name="ThemeButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="ThemeButton_Click">
                        <Path x:Name="ThemeIconPath" Data="{StaticResource PaintbrushIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>

                    <!-- Opacity (blend) -->
                    <Button x:Name="OpacityButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="OpacityButton_Click">
                        <Path x:Name="OpacityIconPath" Data="{StaticResource BlendIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>

                    <!-- Pin -->
                    <Button x:Name="PinButton" Grid.Column="3" Style="{StaticResource IconButtonStyle}" Click="PinButton_Click">
                        <Path x:Name="PinIconPath" Data="{StaticResource PinIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>

                    <!-- Minimize to tray -->
                    <Button x:Name="CloseButton" Grid.Column="4" Style="{StaticResource IconButtonStyle}" Click="CloseButton_Click">
                        <Path x:Name="CloseIconPath" Data="{StaticResource Minimize2Icon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Opacity Slider (hidden) -->
            <Border x:Name="OpacitySliderBorder" Grid.Row="1" Background="{DynamicResource bg/soft}" Padding="16,8" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Opacity" Foreground="{DynamicResource fg/secondary}" FontFamily="{DynamicResource FontRegular}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Slider Name="OpacitySlider" Width="160" Minimum="0.2" Maximum="1.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OpacitySlider_Changed"/>
                    <TextBlock Name="OpacityValueText" Text="100%" Foreground="{DynamicResource fg/secondary}" FontFamily="{DynamicResource FontRegular}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" Width="36"/>
                </StackPanel>
            </Border>

            <!-- === Tasks View === -->
            <Border x:Name="TasksView" Grid.Row="2" Grid.RowSpan="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Scrollable area: active tasks + completed tasks -->
                    <Border Grid.Row="0" Padding="8,8,8,0">
                        <Grid Name="TodoListGrid">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewerStyle}">
                            <StackPanel>
                                <!-- Active Todo List -->
                                <ItemsControl Name="TodoList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="TaskCard" Background="{DynamicResource bg/task}" CornerRadius="8" Padding="8" Margin="0,0,0,6"
                                                    ClipToBounds="True"
                                                    MouseEnter="TaskBorder_MouseEnter" MouseLeave="TaskBorder_MouseLeave"
                                                    PreviewMouseLeftButtonDown="TaskBorder_MouseLeftButtonDown"
                                                    PreviewMouseMove="TaskBorder_MouseMove"
                                                    PreviewMouseLeftButtonUp="TaskBorder_MouseLeftButtonUp">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Opacity" Value="0.5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}" Click="TodoCheckbox_Click" Tag="{Binding Id}" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <CheckBox.Template>
                                                            <ControlTemplate TargetType="CheckBox">
                                                                <Grid Width="22" Height="22" Cursor="Hand">
                                                                    <Border x:Name="CBBorder" Width="22" Height="22" CornerRadius="8" Background="{DynamicResource bg/checkbox-empty}"/>
                                                                    <Path x:Name="CBCheck" Data="{StaticResource CheckIcon}" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" Margin="0,0,0,2" Width="14" Height="14" Stretch="Uniform"/>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="CBBorder" Property="Background" Value="{DynamicResource bg/checkbox-filled}"/>
                                                                        <Setter TargetName="CBCheck" Property="Visibility" Value="Visible"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="CBBorder" Property="Background" Value="{DynamicResource bg/checkbox-empty/hover}"/>
                                                                    </Trigger>
                                                                    <MultiTrigger>
                                                                        <MultiTrigger.Conditions>
                                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                                            <Condition Property="IsChecked" Value="True"/>
                                                                        </MultiTrigger.Conditions>
                                                                        <Setter TargetName="CBBorder" Property="Background" Value="{DynamicResource bg/checkbox-filled/hover}"/>
                                                                    </MultiTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </CheckBox.Template>
                                                    </CheckBox>

                                                    <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock x:Name="TaskTitleText" Text="{Binding Title}" TextWrapping="Wrap" TextTrimming="None"
                                                                   VerticalAlignment="Center" FontFamily="{DynamicResource FontRegular}" FontSize="14" Foreground="{DynamicResource fg/primary}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Effect" Value="{DynamicResource TextGlowEffect}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource fg/secondary}"/>
                                                                            <Setter Property="Effect" Value="{x:Null}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Border x:Name="StrikeLine" Height="1.5" Background="{DynamicResource fg/secondary}"
                                                                VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                                RenderTransformOrigin="0, 0.5" IsHitTestVisible="False" CornerRadius="0.75" Opacity="0.85">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform x:Name="StrikeScale" ScaleX="0" ScaleY="1"/>
                                                            </Border.RenderTransform>
                                                        </Border>
                                                    </Grid>

                                                    <StackPanel x:Name="IconsPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Flame icon (urgent) - visible on hover or when urgent -->
                                                        <Border x:Name="FireBorder" Visibility="Collapsed" Cursor="Hand" Padding="4,2" Margin="0,0,4,0"
                                                                Tag="{Binding Id}" MouseLeftButtonDown="UrgentText_Click">
                                                            <Border.ToolTip>
                                                                <ToolTip Background="{DynamicResource bg/task}" BorderBrush="{DynamicResource border/widget}" BorderThickness="1">
                                                                    <TextBlock Text="Пометить как срочное" Foreground="{DynamicResource fg/primary}" FontFamily="{DynamicResource FontRegular}" FontSize="12"/>
                                                                </ToolTip>
                                                            </Border.ToolTip>
                                                            <Border Width="18" Height="18" VerticalAlignment="Center" ClipToBounds="True">
                                                                <Viewbox Stretch="Uniform">
                                                                    <lottie:LottieAnimationView x:Name="FireIcon"
                                                                          AutoPlay="True" RepeatCount="-1"
                                                                          Width="18" Height="18"
                                                                          MinWidth="0" MinHeight="0"
                                                                          ResourcePath="pack://application:,,,/Animations/flame.json"/>
                                                                </Viewbox>
                                                            </Border>
                                                        </Border>

                                                        <!-- Delete button -->
                                                        <TextBlock Text="&#x2715;" Tag="{Binding Id}" MouseLeftButtonDown="DeleteText_Click"
                                                                   Foreground="{DynamicResource fg/danger}" FontFamily="{DynamicResource FontRegular}" FontSize="14"
                                                                   Cursor="Hand" VerticalAlignment="Center" Padding="8,2" Opacity="0.7">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Opacity" Value="1"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Completed tasks section -->
                                <Border x:Name="CompletedSection" Visibility="Collapsed" Cursor="Hand"
                                        MouseLeftButtonDown="CompletedSection_Click" Padding="4,6,4,2" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Path x:Name="CompletedArrow" Data="M9 18l6-6-6-6" Stroke="{DynamicResource fg/secondary}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Name="CompletedText" Text="Завершенные (0)" Foreground="{DynamicResource fg/secondary}" FontFamily="{DynamicResource FontRegular}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Completed tasks list -->
                                <ItemsControl Name="CompletedList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource bg/task}" CornerRadius="8" Padding="8" Margin="0,0,0,6" Opacity="0.5"
                                                    ClipToBounds="True"
                                                    MouseEnter="TaskBorder_MouseEnter" MouseLeave="TaskBorder_MouseLeave">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}" Click="TodoCheckbox_Click" Tag="{Binding Id}" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <CheckBox.Template>
                                                            <ControlTemplate TargetType="CheckBox">
                                                                <Grid Width="22" Height="22" Cursor="Hand">
                                                                    <Border x:Name="CBBorder" Width="22" Height="22" CornerRadius="8" Background="{DynamicResource bg/checkbox-filled}"/>
                                                                    <Path x:Name="CBCheck" Data="{StaticResource CheckIcon}" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,0,2" Width="14" Height="14" Stretch="Uniform"/>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="CBBorder" Property="Background" Value="{DynamicResource bg/checkbox-filled/hover}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </CheckBox.Template>
                                                    </CheckBox>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextDecorations="Strikethrough" Foreground="{DynamicResource fg/secondary}" FontFamily="{DynamicResource FontRegular}" FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="&#x2715;" Tag="{Binding Id}" MouseLeftButtonDown="DeleteText_Click"
                                                               Foreground="{DynamicResource fg/danger}" FontFamily="{DynamicResource FontRegular}" FontSize="14"
                                                               Cursor="Hand" VerticalAlignment="Center" Padding="8,2" Opacity="0.7"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <Border x:Name="DropIndicator" Height="1" Background="{DynamicResource fg/primary}"
                                CornerRadius="0.5" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                Margin="2,0,2,0" IsHitTestVisible="False" Visibility="Collapsed">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="DropIndicatorTransform" Y="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </Border>

                    <!-- Add Task Input -->
                    <Border Grid.Row="1" Padding="8,6,8,10">
                        <Grid Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="{DynamicResource bg/input}" CornerRadius="8">
                                <TextBox Name="NewTaskInput"
                                         Style="{StaticResource FlatTextBox}"
                                         BorderThickness="0"
                                         FontFamily="{DynamicResource FontRegular}" FontSize="14"
                                         Foreground="{DynamicResource fg/primary}"
                                         Effect="{DynamicResource TextGlowEffect}"
                                         VerticalContentAlignment="Center"
                                         Background="Transparent"
                                         CaretBrush="{DynamicResource bg/checkbox-filled}"
                                         KeyDown="NewTaskInput_KeyDown"
                                         TextChanged="NewTaskInput_TextChanged"
                                         GotFocus="NewTaskInput_GotFocus"
                                         LostFocus="NewTaskInput_LostFocus"/>
                            </Border>
                            <TextBlock Name="WatermarkText" Text="Add a task..." Margin="8,0,0,0" FontFamily="{DynamicResource FontRegular}" FontSize="14" Foreground="{DynamicResource fg/secondary}" IsHitTestVisible="False" VerticalAlignment="Center"/>

                            <Button Grid.Column="1" Name="AddButton" Width="32" Height="32" Margin="6,0,0,0" Background="{DynamicResource bg/button}" BorderThickness="0" Cursor="Hand" Click="AddButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                                                        <Path Data="M5 12h14 M12 5v14" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource bg/button/hover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- === Themes View (hidden) === -->
            <Border x:Name="ThemesView" Grid.Row="2" Grid.RowSpan="2" Visibility="Collapsed" Padding="12,12">
                <Border.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Effect" Value="{DynamicResource TextGlowEffect}"/>
                    </Style>
                </Border.Resources>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewerStyle}">
                    <StackPanel>
                    <!-- Dark theme -->
                    <Border x:Name="DarkThemeItem" Background="{DynamicResource bg/task}" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="DarkTheme_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dark" Foreground="{DynamicResource fg/primary}" FontFamily="{DynamicResource FontRegular}" FontSize="14" VerticalAlignment="Center"/>
                            <Path x:Name="DarkCheck" Grid.Column="1" Data="{StaticResource CheckIcon}" Stroke="{DynamicResource bg/checkbox-filled}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Light theme -->
                    <Border x:Name="LightThemeItem" Background="{DynamicResource bg/task}" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="LightTheme_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Light" Foreground="{DynamicResource fg/primary}" FontFamily="{DynamicResource FontRegular}" FontSize="14" VerticalAlignment="Center"/>
                            <Path x:Name="LightCheck" Grid.Column="1" Data="{StaticResource CheckIcon}" Stroke="{DynamicResource bg/checkbox-filled}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Opacity="0"/>
                        </Grid>
                    </Border>

                    <!-- Kanagawa theme -->
                    <Border x:Name="KanagawaThemeItem" Background="{DynamicResource bg/task}" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="KanagawaTheme_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
